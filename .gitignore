# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules

# Expo
.expo/
dist/
dist-test/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files: no .env at all (X1: the test switch must never come from a file), the local ones stay ignored too
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local screenshot runs are regenerated each version; keep them out of git history except reviewed ones

# App Store reference screenshots are third-party marketing art: local-only, never commit
screenshots/reference/

# audio build intermediates
tools/audio/build/
__pycache__/

# per-round review sets built by scripts/review_shots.py
screenshots/*/review/
# scratch sets from one-fixture runs (scripts/screenshots.py dev --only ...) and side-by-side retakes
screenshots/dev/
screenshots/*-b/
saves/
vis/
seeded/

# music pipeline scratch (card M0): renders and soundfonts are not in git
tools/audio/build/
tools/audio/banks/
