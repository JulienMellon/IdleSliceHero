# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local screenshot runs are regenerated each version; keep them out of git history except reviewed ones

# App Store reference screenshots are third-party marketing art: local-only, never commit
screenshots/reference/

# audio build intermediates
tools/audio/build/
__pycache__/

# per-round review sets built by scripts/review_shots.py
screenshots/*/review/
