{
  "name": "slice-empire",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "8.28.1",
    "expo": "58.0.20",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "posthog-react-native": "4.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "1.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "17.4.0",
    "react-native-purchases": "11.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:test": "EXPO_PUBLIC_TEST_MODE=1 npx expo export --platform web --output-dir dist-test",
    "test-snapshots": "npx tsx scripts/test-snapshots.ts",
    "check:no-test-mode": "bash scripts/check-no-test-mode.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"*.js\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"*.js\" \"*.ts\""
  },
  "private": true,
  "engines": {
    "node": ">=22 <23"
  }
}
