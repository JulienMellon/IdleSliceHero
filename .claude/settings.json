{
  "model": "opusplan",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx jest *)",
      "WebSearch",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:docs.swmansion.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
